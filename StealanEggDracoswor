-- Função para carregar o ID do Adesivo do Roblox
task.spawn(function()
    local decalAssetId = 132825744969037
    local success, assetInfo = pcall(function()
        return MarketplaceService:GetProductInfo(decalAssetId)
    end)

    if success and assetInfo and assetInfo.AssetTypeId == 13 then
        DiscordIcon.Image = "rbxassetid://" .. tostring(decalAssetId)
    else
        DiscordIcon.Image = "http://www.roblox.com/asset/?id=" .. tostring(decalAssetId)
    end
end)

