-- Função de Cópia
DiscordBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard("https://discord.com/invite/nxBMCYEEM")
        StatusLabel.Text = "✓ Link do Discord copiado com sucesso!"
        
        BtnStroke.Color = Color3.fromRGB(0, 255, 120)
        task.wait(1.5)
        BtnStroke.Color = Color3.fromRGB(255, 30, 60)
        StatusLabel.Text = ""
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        StatusLabel.Text = "✕ Seu executor não suporta cópia automática."
    end
end)
